managed implementation in class zbp_anvg_r_game unique;
strict ( 2 );

define behavior for ZANVG_R_GAME alias Game
persistent table zanvg_t_game
lock master
authorization master ( global )
etag master LocalLastChangedAt
{
  create;
  internal update;
  delete;
  association _Guess { internal create; }
  determination setDefaults on modify { create; }
  action ( features : instance ) SubmitGuess parameter ZANVG_D_GUESS result [1] $self;
  static factory action StartGame parameter ZANVG_D_PLAYER [1];

  side effects
  {
    action SubmitGuess affects field Status, field StatusText, field StatusCriticality, field Attempts, field Lives, field Score, field Solution, entity _Guess, permissions ( action SubmitGuess );
  }

  field ( readonly, numbering : managed ) GameId;
  field ( readonly ) SecretWord, Status, StatusText, StatusCriticality, GameModeText, Attempts, Lives, Score, Solution, CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( readonly : update ) GameMode;

  mapping for zanvg_t_game
    {
      GameId             = game_id;
      Player             = player;
      SecretWord         = secret_word;
      Status             = status;
      GameMode           = game_mode;
      Attempts           = attempts;
      Lives              = lives;
      Score              = score;
      CreatedBy          = created_by;
      CreatedAt          = created_at;
      LastChangedBy      = last_changed_by;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}

define behavior for ZANVG_R_GUESS alias Guess
persistent table zanvg_t_guess
lock dependent by _Game
authorization dependent by _Game
etag dependent by _Game
